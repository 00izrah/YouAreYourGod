---
import { site } from '../site.config';

interface Props {
  /** Which top-level section is active (used for aria-current + brass). */
  current?: 'exhibitions' | 'archive' | 'notes' | 'info';
  /** `EX-01 · The Geometry of Midday`, shown on the right inside a room. */
  roomLabel?: string;
}

const { current, roomLabel } = Astro.props;
const links = [
  { id: 'exhibitions', href: '/exhibitions', label: 'Exhibitions' },
  { id: 'archive', href: '/archive', label: 'Archive' },
  { id: 'notes', href: '/notes', label: 'Notes' },
  { id: 'info', href: '/info', label: 'Info' },
] as const;
---

<header class="site-header">
  <a class="site-name" href="/" aria-label={`${site.name}, home`}>{site.name}</a>

  <div class="nav-right">
    {roomLabel && <p class="room-label">{roomLabel}</p>}

    <nav aria-label="Primary">
      <!-- On narrow screens this is a popover opened by the single word "Menu"; on wide screens it is inline. -->
      <button class="menu-button" type="button" popovertarget="site-menu" aria-label="Open menu">Menu</button>
      <div class="nav-links" id="site-menu" popover="auto">
        <button class="menu-close" type="button" popovertarget="site-menu" popovertargetaction="hide">Close</button>
        {
          links.map((l) => (
            <a href={l.href} aria-current={current === l.id ? 'page' : undefined}>
              {l.label}
            </a>
          ))
        }
      </div>
    </nav>
  </div>
</header>
