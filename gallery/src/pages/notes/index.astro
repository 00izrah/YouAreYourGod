---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const notes = (await getCollection('notes')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const fmt = new Intl.DateTimeFormat('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
---

<Base title="Field notes" current="notes" description="Field notes: context, tones and the moment behind a frame.">
  <div class="page">
    <p class="kicker">Darkroom</p>
    <h1 class="page-title">Field notes</h1>
    <ul class="note-list">
      {
        notes.map((n) => (
          <li>
            <a class="note-row" href={`/notes/${n.id}`}>
              <span class="label">{fmt.format(n.data.date)}</span>
              <h2>{n.data.title}</h2>
              <p>{n.data.summary}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
