---
import Base from '../layouts/Base.astro';
import FramePicture from '../components/FramePicture.astro';
import { getExhibitions, allFrames, pad } from '../lib/exhibitions';

const exhibitions = (await getExhibitions()).filter((e) => e.data.frames.length > 0);
const frames = allFrames(exhibitions);
const years = [...new Set(frames.map((f) => f.year))].sort((a, b) => b - a);
---

<Base
  title="Archive"
  current="archive"
  description="The permanent collection: every frame, filed by exhibition and year."
>
  <div class="page">
    <p class="kicker">The permanent collection</p>
    <h1 class="page-title">Archive</h1>

    <div class="filters" data-filters>
      <div class="filter-group" role="group" aria-label="Filter by exhibition">
        <span>Exhibition</span>
        <button type="button" data-key="exhibition" data-value="" aria-pressed="true">All</button>
        {
          exhibitions.map((e) => (
            <button type="button" data-key="exhibition" data-value={e.id} aria-pressed="false">
              {e.data.number}
            </button>
          ))
        }
      </div>
      {
        years.length > 1 && (
          <div class="filter-group" role="group" aria-label="Filter by year">
            <span>Year</span>
            <button type="button" data-key="year" data-value="" aria-pressed="true">All</button>
            {years.map((y) => (
              <button type="button" data-key="year" data-value={String(y)} aria-pressed="false">
                {y}
              </button>
            ))}
          </div>
        )
      }
      <p class="label" role="status" aria-live="polite" data-status></p>
    </div>

    <ul class="sheet" data-sheet>
      {
        frames.map(({ exhibition, frame, index, year, url }) => (
          <li data-exhibition={exhibition.id} data-year={year}>
            <a class="cell" href={url}>
              <FramePicture
                image={frame.image}
                alt={frame.alt}
                sizes="(max-width: 40rem) 45vw, 14rem"
                widths={[320, 480, 640]}
                dominantColor={frame.dominantColor}
                fallbackWidth={640}
              />
              <span class="cap">
                {exhibition.data.number} · {pad(index + 1)}
                <br />
                {frame.title}
                <br />
                {frame.location} · {year}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <script>
    import '../scripts/archive-filter';
  </script>
</Base>
