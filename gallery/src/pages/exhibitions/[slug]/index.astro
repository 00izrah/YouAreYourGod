---
import { getExhibitions, frameUrl } from '../../../lib/exhibitions';

export async function getStaticPaths() {
  const exhibitions = await getExhibitions();
  return exhibitions
    .filter((e) => e.data.frames.length > 0)
    .map((e) => ({ params: { slug: e.id }, props: { to: frameUrl(e.id, 0) } }));
}

const { to } = Astro.props;
---

<!-- /exhibitions/[slug] always opens frame 1 of the room. -->
<meta http-equiv="refresh" content={`0; url=${to}`} />
<link rel="canonical" href={to} />
<meta name="robots" content="noindex" />
<title>Redirecting…</title>
<p><a href={to}>Enter the room</a></p>
